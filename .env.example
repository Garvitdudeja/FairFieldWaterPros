# Copy this file to .env.local for local development,
# and add the same values in Vercel under Settings > Environment Variables.

# Your live domain. Used for canonical URLs, Open Graph tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.fairfieldcountywaterpros.com

# Optional. Quote requests go to Zoho CRM using the form values hardcoded in
# app/api/lead/route.ts. Set these only if you regenerate the form in Zoho —
# they are the `xnQsjsdp` and `xmIwtLD` values from its HTML snippet.
ZOHO_FORM_ID=
ZOHO_FORM_KEY=

# Optional. A second copy of each quote request, so you hear about it without
# opening the CRM. Paste a webhook URL from Zapier, Make, or Slack.
# Leave it unset and nothing is lost — the lead is already in Zoho.
LEAD_WEBHOOK_URL=
