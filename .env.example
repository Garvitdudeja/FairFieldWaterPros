# Copy this file to .env.local for local development,
# and add the same values in Vercel under Settings > Environment Variables.

# Your live domain. Used for canonical URLs, Open Graph tags and the sitemap.
# If you don't have the domain yet, leave the variable out of your host's
# settings entirely rather than adding it with an empty value. Blank, missing
# and malformed values all fall back to the default now, so neither breaks the
# build — but "not set" is the clearer thing to look at six months from now.
NEXT_PUBLIC_SITE_URL=https://www.fairfieldcountywaterpros.com

# There is nothing else to set. The quote form posts straight from the
# visitor's browser to Zoho CRM; its form id and key live in lib/zoho.ts,
# because they are public values that appear in any embedded Zoho form.
