# Copy this file to .env.local for local development,
# and add the same values in Vercel under Settings > Environment Variables.

# Your live domain. Used for canonical URLs, Open Graph tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.fairfieldcountywaterpros.com

# Optional. Where a submitted "free water test" form gets sent.
# Paste a webhook URL from Zapier, Make, Slack, or your CRM.
# Leave it unset and submissions are written to the server log instead —
# the form still works, you just have to read the logs to see leads.
LEAD_WEBHOOK_URL=
